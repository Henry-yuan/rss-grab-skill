# rss-grab 环境变量配置（**本文件是全仓库唯一的配置模板**，填入真实值后生效）
#
# ⚠️ 生效位置：脚本只读本目录（scripts/）下的 .env，**仓库根目录的 .env 不会被读取**。
#    在仓库根目录执行：
#      cp .agents/skills/rss-grab/scripts/.env.example \
#         .agents/skills/rss-grab/scripts/.env
#    然后编辑 .agents/skills/rss-grab/scripts/.env 填入真实值。
#    缺 key 时脚本的报错信息里也会打印这条真实路径，照着走即可。

# 必填：你的 LLM 服务 API key（OpenAI 兼容接口，任意服务）
LLM_API_KEY=your-api-key-here

# 必填：你的 LLM 服务 OpenAI 兼容接口地址（DeepSeek / OpenAI / MiniMax / Ollama 等）
LLM_BASE_URL=https://your-llm-service.example.com/v1

# 必填：你的模型名（所有脚本必读，缺失会在运行时报错退出）
LLM_MODEL=your-model-name

# 输出预算天花板（2026-10-04 新增）。**不是限长工具**，调小不会让输出变短、
# 只会让推理模型的 thinking token 吃光预算导致正文被截断。详见 map_reduce_note.py 注释。
# map-reduce 的 map / reduce 两个阶段共用（期望输出 2,900–27,600 token）。
LLM_MAX_COMPLETION=100000
# 订阅拉取的短摘要（preview_podcast.py）单独一个键：期望输出仅数百 token。
LLM_SUMMARY_MAX_COMPLETION=16000

# ---------------------------------------------------------------------------
# 以下**可选**：只有「飞书表格镜像」（lark_sync.py）才读。
# 不用这个功能就整段删掉，不影响上面任何能力。
# ⚠️ 这里只放变量名，**不要把真值提交进仓库**（.env 本身已被 gitignore）。
#    飞书应用自身的登录由 lark-cli 自己管（lark-cli auth login），
#    本项目不碰 app_id / app_secret。
# ---------------------------------------------------------------------------

# 表格 token（表格链接里 base 与表格标识之间那串字符）
LARK_SPREADSHEET_TOKEN=
# 子表名；留空则默认取节目名
LARK_SHEET_NAME=
