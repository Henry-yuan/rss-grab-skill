# rss-grab 环境变量配置（复制为 .env 并填入真实值）
# cp .env.example .env
# ⚠️ 注意生效位置：脚本只读本目录（scripts/）下的 .env，根目录 .env 不会被读取

# 必填：你的 LLM 服务 API key（OpenAI 兼容接口，任意服务）
LLM_API_KEY=your-api-key-here

# 必填：你的 LLM 服务 OpenAI 兼容接口地址（DeepSeek / OpenAI / MiniMax / Ollama 等）
LLM_BASE_URL=https://your-llm-service.example.com/v1

# 必填：你的模型名（所有脚本必读，缺失会在运行时报错退出）
LLM_MODEL=your-model-name

# 输出预算天花板（2026-10-04 新增）。**不是限长工具**，调小不会让输出变短、
# 只会让推理模型的 thinking token 吃光预算导致正文被截断。详见 map_reduce_note.py 注释。
# map-reduce 的 map / reduce 两个阶段共用（期望输出 2,900–27,600 token）。
LLM_MAX_COMPLETION=100000
# 订阅拉取的短摘要（preview_podcast.py）单独一个键：期望输出仅数百 token。
LLM_SUMMARY_MAX_COMPLETION=16000
