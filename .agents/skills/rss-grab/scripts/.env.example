# rss-grab 环境变量配置（复制为 .env 并填入真实值）
# cp .env.example .env

# 必填：你的 LLM 服务 API key（OpenAI 兼容接口）
# 默认示例用 MiniMax（https://platform.minimaxi.com/user-center/payment/token-plan）
LLM_API_KEY=your-api-key-here

# 可选：默认用 MiniMax，可换其他 OpenAI 兼容服务（DeepSeek / OpenAI / Ollama 等）
# LLM_BASE_URL=https://api.minimaxi.com/v1
# LLM_MODEL=MiniMax-M3
