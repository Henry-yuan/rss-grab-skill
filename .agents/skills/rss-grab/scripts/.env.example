# rss-grab 环境变量配置（**本文件是全仓库唯一的配置模板**，填入真实值后生效）
#
# ⚠️ 生效位置：脚本只读本目录（scripts/）下的 .env，**仓库根目录的 .env 不会被读取**。
#    在仓库根目录执行：
#      cp .agents/skills/rss-grab/scripts/.env.example \
#         .agents/skills/rss-grab/scripts/.env
#    然后编辑 .agents/skills/rss-grab/scripts/.env 填入真实值。
#    缺 key 时脚本的报错信息里也会打印这条真实路径，照着走即可。

# 必填：你的 LLM 服务 API key（OpenAI 兼容接口，任意服务）
LLM_API_KEY=your-api-key-here

# 必填：你的 LLM 服务 OpenAI 兼容接口地址（DeepSeek / OpenAI / MiniMax / Ollama 等）
LLM_BASE_URL=https://your-llm-service.example.com/v1

# 必填：你的模型名（所有脚本必读，缺失会在运行时报错退出）
# 笔记生成管线（_shared/）内部的取值顺序：本键 -> MINIMAX_MODEL -> 内置默认
# MiniMax-M3.1-Flash-Preview，所以改服务只需改这一行，不用动代码。
LLM_MODEL=your-model-name

# 推理强度（**可选**，不写就用各阶段各自的默认值：
#          摘要 high / 笔记撰写 max / 分块扫描 xhigh / 合并 medium）
# 取值：low / medium / high / xhigh / max
# ⚠️ 显式留空（LLM_EFFORT=）在**笔记生成管线**里 = 不发送 reasoning_effort 参数 ——
#    服务端不认这个参数、又想避开「不设 = Max」的默认档位时，用这个开关。
#    摘要脚本的空值行为以 preview_podcast.py 里 reasoning_effort= 那一行为准，
#    不确定就别写这一行（留着注释即可，默认档位是能跑的）。
# LLM_EFFORT=high

# 输出预算天花板（2026-10-04 新增）。**不是限长工具**，调小不会让输出变短、
# 只会让推理模型的 thinking token 吃光预算导致正文被截断。
# 2026-10-14 校正：原写「详见 map_reduce_note.py 注释」，该文件**不存在**，
# 照着去翻必然翻不到（实际文件名带 _v2 后缀）。真正的读取方是笔记 v3 管线三处：
#   _shared/correct_typos.py（纠错）、_shared/chunk_scan.py（分块扫描/合并）、
#   _shared/build_v3.py（撰写）。想调这个值看这三处的调用处。
#   （退役的 map-reduce v2 路径 map_reduce_note_v2.py 也读同一个键。）
LLM_MAX_COMPLETION=100000
# 订阅拉取的短摘要（preview_podcast.py）单独一个键：期望输出仅数百 token。
LLM_SUMMARY_MAX_COMPLETION=16000

# ---------------------------------------------------------------------------
# 以下**可选**：只有「飞书表格镜像」（lark_sync.py）才读。
# 不用这个功能就整段删掉，不影响上面任何能力。
# ⚠️ 这里只放变量名，**不要把真值提交进仓库**（.env 本身已被 gitignore）。
#    飞书应用自身的登录由 lark-cli 自己管（lark-cli auth login），
#    本项目不碰 app_id / app_secret。
# ---------------------------------------------------------------------------

# ⚠️ 键名以 lark_sync.py 实读的为准（已 grep 复核：全脚本只读下面这两个）。
#    旧文档里的 LARK_SPREADSHEET_TOKEN / LARK_SHEET_NAME 是普通表格那套，
#    代码早已不读 —— 照旧名填会「配了却静默失效」。
# 多维表格 token（必填）：表格链接里 /base/ 后面那串字符
LARK_BASE_TOKEN=
# 数据表 table_id（必填，形如 tblXXXX）：多维表格里任一数据表的标识
LARK_TABLE_ID=
# 两者都必填，缺任一个 lark_sync 会明确报错并非零退出（不做静默降级）。
