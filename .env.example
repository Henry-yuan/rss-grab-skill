# rss-grab 环境变量配置（复制为 .agents/skills/rss-grab/scripts/.env 并填入真实值）
# ⚠️ 注意生效位置：脚本只读 scripts/ 目录下的 .env，放在根目录不会被读取
# cp .env.example .agents/skills/rss-grab/scripts/.env

# 必填：你的 LLM 服务 API key（OpenAI 兼容接口，任意服务）
LLM_API_KEY=your-api-key-here

# 必填：你的 LLM 服务 OpenAI 兼容接口地址（DeepSeek / OpenAI / MiniMax / Ollama 等）
LLM_BASE_URL=https://your-llm-service.example.com/v1

# 必填：你的模型名（所有脚本必读，缺失会在运行时报错退出）
LLM_MODEL=your-model-name
